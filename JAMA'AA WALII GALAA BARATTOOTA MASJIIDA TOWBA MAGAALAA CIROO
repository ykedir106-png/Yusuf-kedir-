<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Jem'aa Barattoota Waliigalaa Masjida Tawbaa</title>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>

:root{
  --green:#075b3a;
  --green2:#0b8050;
  --green3:#eaf7f0;
  --gold:#f0c94b;
  --dark:#12352a;
  --text:#173b2b;
  --muted:#6a7c73;
  --white:#fff;
  --danger:#b3261e;
  --warning:#d99a00;
  --success:#188344;
  --bg:#f4f8f5;
  --border:#dfe9e3;
  --shadow:0 10px 30px rgba(0,0,0,.08);
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:var(--bg);
  color:var(--text);
  line-height:1.6;
}

a{
  text-decoration:none;
}

button,
input,
textarea,
select{
  font:inherit;
}

button{
  cursor:pointer;
  border:0;
}

/* ================= HEADER ================= */

header{
  position:sticky;
  top:0;
  z-index:999;
  background:rgba(7,91,58,.97);
  color:white;
  box-shadow:0 4px 20px rgba(0,0,0,.15);
}

nav{
  max-width:1250px;
  margin:auto;
  min-height:70px;
  padding:10px 18px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:15px;
}

.logo{
  display:flex;
  align-items:center;
  gap:9px;
  font-size:19px;
  font-weight:800;
  white-space:nowrap;
}

.logo-icon{
  width:40px;
  height:40px;
  display:grid;
  place-items:center;
  background:rgba(255,255,255,.15);
  border-radius:12px;
  font-size:22px;
}

nav ul{
  list-style:none;
  display:flex;
  align-items:center;
  justify-content:center;
  flex-wrap:wrap;
  gap:3px;
}

nav a{
  color:white;
  padding:8px 9px;
  border-radius:8px;
  font-size:13px;
  transition:.2s;
}

nav a:hover{
  background:rgba(255,255,255,.14);
}

.lang{
  background:white;
  color:var(--green);
  border:0;
  padding:8px 10px;
  border-radius:8px;
  font-weight:bold;
}

/* ================= HERO ================= */

.hero{
  min-height:78vh;
  display:grid;
  place-items:center;
  text-align:center;
  padding:70px 20px;
  color:white;
  background:
    radial-gradient(circle at 20% 20%,rgba(255,255,255,.10),transparent 30%),
    radial-gradient(circle at 80% 80%,rgba(240,201,75,.10),transparent 30%),
    linear-gradient(135deg,#064a31,#0c8a57);
  position:relative;
  overflow:hidden;
}

.hero:before{
  content:"";
  position:absolute;
  width:350px;
  height:350px;
  border:1px solid rgba(255,255,255,.12);
  border-radius:50%;
  right:-100px;
  top:-100px;
}

.hero-content{
  max-width:900px;
  position:relative;
}

.badge{
  display:inline-block;
  background:rgba(255,255,255,.13);
  border:1px solid rgba(255,255,255,.18);
  padding:7px 14px;
  border-radius:30px;
  margin-bottom:20px;
  font-size:14px;
}

.hero h1{
  font-size:clamp(34px,6vw,64px);
  line-height:1.1;
  margin-bottom:20px;
}

.hero p{
  max-width:760px;
  margin:auto;
  font-size:18px;
  opacity:.95;
}

.hero-buttons{
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap:12px;
  margin-top:28px;
}

.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:12px 20px;
  border-radius:9px;
  font-weight:700;
  transition:.2s;
}

.btn-primary{
  background:var(--gold);
  color:#183d2d;
}

.btn-primary:hover{
  transform:translateY(-2px);
}

.btn-light{
  color:white;
  border:1px solid rgba(255,255,255,.4);
  background:rgba(255,255,255,.08);
}

.btn-light:hover{
  background:rgba(255,255,255,.16);
}

/* ================= GENERAL ================= */

main{
  max-width:1250px;
  margin:auto;
}

section{
  padding:75px 20px;
}

.title{
  text-align:center;
  margin-bottom:35px;
}

.title h2{
  color:var(--green);
  font-size:34px;
  margin-bottom:8px;
}

.title p{
  color:var(--muted);
}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
  gap:20px;
}

.card{
  background:white;
  border:1px solid var(--border);
  border-radius:16px;
  padding:24px;
  box-shadow:var(--shadow);
}

.card h3{
  color:var(--green);
  margin-bottom:9px;
}

.card-icon{
  width:48px;
  height:48px;
  display:grid;
  place-items:center;
  border-radius:13px;
  background:var(--green3);
  font-size:23px;
  margin-bottom:15px;
}

.notice{
  background:#fff9df;
  border-left:5px solid var(--gold);
  padding:16px 18px;
  margin-bottom:12px;
  border-radius:10px;
}

.form{
  max-width:700px;
  margin:auto;
  background:white;
  padding:28px;
  border-radius:18px;
  box-shadow:var(--shadow);
  border:1px solid var(--border);
}

label{
  display:block;
  margin:14px 0 6px;
  font-weight:700;
}

input,
textarea,
select{
  width:100%;
  padding:12px 13px;
  border:1px solid #cfdcd4;
  border-radius:9px;
  background:white;
  color:var(--text);
  outline:none;
}

input:focus,
textarea:focus,
select:focus{
  border-color:var(--green2);
  box-shadow:0 0 0 3px rgba(11,128,80,.1);
}

textarea{
  min-height:110px;
  resize:vertical;
}

.submit{
  background:var(--green);
  color:white;
  padding:12px 18px;
  border-radius:9px;
  margin-top:15px;
  font-weight:700;
}

.submit:hover{
  background:var(--green2);
}

.success,
.error{
  padding:13px;
  border-radius:9px;
  margin-top:14px;
  display:none;
}

.success{
  background:#e5f7eb;
  color:#176b38;
}

.error{
  background:#fde8e7;
  color:#9b1c1c;
}

/* ================= ADMIN ================= */

.admin-panel{
  display:none;
}

.admin-header{
  display:flex;
  align-items:center;
  justify-content:space-between;
  flex-wrap:wrap;
  gap:15px;
  margin-bottom:20px;
}

.admin-welcome{
  color:var(--muted);
}

.stats{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(170px,1fr));
  gap:16px;
  margin:20px 0 30px;
}

.stat{
  background:white;
  border:1px solid var(--border);
  border-radius:15px;
  padding:22px;
  text-align:center;
  box-shadow:var(--shadow);
}

.stat-icon{
  font-size:25px;
}

.stat-number{
  font-size:35px;
  font-weight:800;
  color:var(--green);
}

.stat.pending .stat-number{
  color:var(--warning);
}

.stat.accepted .stat-number{
  color:var(--success);
}

.stat.declined .stat-number{
  color:var(--danger);
}

/* ================= STUDENTS ================= */

.student-row{
  background:white;
  border:1px solid var(--border);
  border-radius:13px;
  padding:17px;
  margin-bottom:12px;
  box-shadow:0 4px 15px rgba(0,0,0,.04);
}

.student-name{
  font-weight:800;
  color:var(--green);
  font-size:17px;
}

.student-info{
  color:var(--muted);
  font-size:14px;
  margin-top:4px;
}

.status{
  display:inline-block;
  padding:5px 10px;
  border-radius:30px;
  font-size:12px;
  font-weight:800;
  margin-top:9px;
}

.status-pending{
  background:#fff2c2;
  color:#876600;
}

.status-accepted{
  background:#d9f5e2;
  color:#176b38;
}

.status-declined{
  background:#fde0de;
  color:#9b1c1c;
}

.actions{
  display:flex;
  flex-wrap:wrap;
  gap:7px;
  margin-top:12px;
}

.action{
  color:white;
  padding:8px 11px;
  border-radius:7px;
  font-size:13px;
  font-weight:bold;
}

.accept{
  background:var(--success);
}

.decline{
  background:var(--warning);
}

.delete{
  background:var(--danger);
}

/* ================= ATTENDANCE ================= */

.attendance-toolbar{
  background:white;
  padding:20px;
  border-radius:15px;
  border:1px solid var(--border);
  box-shadow:var(--shadow);
  margin-bottom:18px;
}

.attendance-summary{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  margin-top:15px;
}

.summary-box{
  padding:10px 15px;
  border-radius:9px;
  background:var(--bg);
  font-weight:bold;
}

.table-wrap{
  overflow-x:auto;
  background:white;
  border-radius:15px;
  border:1px solid var(--border);
  box-shadow:var(--shadow);
}

.attendance-table{
  width:100%;
  min-width:650px;
  border-collapse:collapse;
}

.attendance-table th,
.attendance-table td{
  padding:13px;
  border-bottom:1px solid #e7ede9;
  text-align:left;
}

.attendance-table th{
  background:var(--green);
  color:white;
}

.present-btn,
.absent-btn{
  color:white;
  padding:8px 11px;
  border-radius:7px;
  font-size:12px;
  font-weight:bold;
  margin:2px;
}

.present-btn{
  background:var(--success);
}

.absent-btn{
  background:var(--danger);
}

.attendance-active{
  outline:3px solid rgba(7,91,58,.25);
}

/* ================= MANAGEMENT ================= */

.manage-card{
  background:white;
  border:1px solid var(--border);
  padding:20px;
  border-radius:15px;
  margin-bottom:12px;
}

.manage-actions{
  margin-top:10px;
}

/* ================= FOOTER ================= */

footer{
  background:var(--dark);
  color:white;
  text-align:center;
  padding:35px 20px;
}

footer p{
  margin:5px 0;
}

.small{
  font-size:13px;
  color:var(--muted);
}

.loading{
  text-align:center;
  padding:25px;
  color:var(--muted);
}

.empty{
  text-align:center;
  padding:25px;
  color:var(--muted);
}

/* ================= MOBILE ================= */

@media(max-width:950px){

nav{
  flex-direction:column;
}

nav ul{
  gap:2px;
}

}

@media(max-width:600px){

section{
  padding:55px 14px;
}

.hero{
  min-height:75vh;
  padding:55px 15px;
}

.hero h1{
  font-size:37px;
}

.hero p{
  font-size:16px;
}

.title h2{
  font-size:28px;
}

.form{
  padding:20px;
}

.logo{
  font-size:17px;
}

nav a{
  font-size:12px;
  padding:6px;
}

}

</style>
</head>

